# YIELD/YARD — web/ environment. Copy to .env.local for a local override.
# NONE of these are NEXT_PUBLIC_; none reach the client bundle.

# ---------------------------------------------------------------------------
# DATABASE — the one switch.
#
#   UNSET (the default): PGlite, an in-process Postgres. `npm run seed` builds
#     .data/pglite and writes .data/pgdata.tar.gz; the app loads that dump
#     read-only. No service to provision, works offline, works in CI.
#
#   SET: any Postgres, which in this project means Neon. The seed program and
#     the app both follow it — same Drizzle schema, same queries, no code change.
#
#   To swap to Neon:
#       export DATABASE_URL='postgresql://USER:PASSWORD@HOST/DB?sslmode=require'
#       npm run seed && npm run build
#   In Vercel, set DATABASE_URL per environment (read-only role for the app, a
#   read-write role for the seed job) — ARCHITECTURE.md §3, §8.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# GATE #3 flags. The shipping defaults live in etl/config.py and reach the app
# through lib/generated/flags.json (written by scripts/prepare.mjs). Setting one
# here overrides the default for this environment only.
# ---------------------------------------------------------------------------
# TEAM_LOGOS_ENABLED=true      # SPEC §5.1 kill-switch; false = fallback chip everywhere
# DEAD_MONEY_TIER=ALL          # SPEC §7.5; SAFE_ONLY drops the REVIEW tier at seed time
# IMAGE_MIN_WIDTH_PX=300       # SPEC §5.2 OPEN DECISION 1
# IMAGE_TREATMENT_MODE=css_filter_only   # SPEC §5.2 OPEN DECISION 2, option (a)
